<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Override minSdk constraints from all test-only dependencies.
        The production SDK supports minSdk 14; all androidx.test.* libraries
        declare minSdk 19. Real test devices always run API 19+.
    -->
    <uses-sdk
        tools:overrideLibrary="
            androidx.test.ext.junit,
            androidx.test.core,
            androidx.test.runner,
            androidx.test.rules,
            androidx.test.monitor,
            androidx.test.services,
            androidx.test.services.storage,
            androidx.core,
            androidx.lifecycle,
            androidx.lifecycle.common,
            androidx.activity,
            okhttp3,
            com.squareup.okhttp3,
            com.squareup.okio" />

    <!-- PerfReportStore writes JSON/HTML under Download/thinkinganalytics-perf -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="cn.thinkingdata.analytics.AutoTrackTestActivity"
            android:exported="false" />
    </application>
</manifest>
